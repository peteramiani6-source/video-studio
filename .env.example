# Copy to .env and fill in only what you use. .env is gitignored.
# With a Claude subscription (PICKER=claude-code) you need NONE of these: just run `claude` once to log in.
ANTHROPIC_API_KEY=     # only for PICKER=claude (API billing)
GEMINI_API_KEY=        # only for PICKER=gemini
GROQ_API_KEY=          # only for STT=groq (fast transcription of long recordings)
