# Which model handles which step. Loaded by scripts/common.py (and sourced by event.sh and montage.sh).

# Transcription: local (faster-whisper, free, private) | groq (hosted Whisper, fast, needs GROQ_API_KEY)
STT=local
WHISPER_MODEL=small          # CPU-only: base (fast) | small (best balance). medium+ is too slow without a GPU
WHISPER_DEVICE=cpu           # no GPU on this machine
WHISPER_BATCH=8              # batched decoding, ~2-4x faster. Lower it (4) if RAM runs out, 0 = off
WHISPER_LANGUAGE=            # e.g. en: skips language detection. Empty = auto-detect
WHISPER_THREADS=0            # CPU threads, 0 = let faster-whisper decide
GROQ_STT_MODEL=whisper-large-v3-turbo

# Who makes the editing decisions:
#   claude-code = your Claude subscription via the logged-in `claude` CLI (no API key needed)
#   claude      = Anthropic API, pay per token (ANTHROPIC_API_KEY)
#   gemini      = Google Gemini API (GEMINI_API_KEY)
#   none        = no model; evenly spaced clips / whole event kept
PICKER=claude-code
CLAUDE_MODEL=claude-sonnet-5-5   # only for PICKER=claude
GEMINI_MODEL=gemini-2.5-flash

# Clip rules
CLIP_COUNT=4
CLIP_MIN=25                  # seconds
CLIP_MAX=60                  # seconds

# Pause removal inside each clip (uses word timestamps, no extra pass over the recording): 1 = on, 0 = off
SILENCE_CUT=1
SILENCE_MIN_GAP=0.8          # seconds: pauses between words longer than this are cut
SILENCE_MARGIN=0.2           # seconds of breathing room kept on each side of a cut

# Event mode (scripts/event.sh)
EVENT_SOCIAL_CLIPS=1         # also render vertical clips from the event
EVENT_CLIP_COUNT=5
