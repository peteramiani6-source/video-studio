{
  "width": 1080,
  "height": 1920,
  "fps": 30,
  "caption": {
    "font": "DejaVu Sans",
    "font_size": 14,
    "bold": true,
    "primary_color": "#FFFFFF",
    "outline_color": "#000000",
    "outline": 2,
    "shadow": 0,
    "margin_v": 70,
    "max_chars_per_line": 28
  },
  "hook": {
    "enabled": true,
    "seconds": 1.5,
    "font_size": 84,
    "color": "#FFFFFF",
    "anchor": "bottom",
    "y": 0.61,
    "shadow": 5,
    "shadow_color": "#000000",
    "outline": 3,
    "outline_color": "#000000",
    "box": false,
    "box_color": "#000000",
    "box_opacity": 0.6,
    "max_chars_per_line": 16
  },
  "look": {
    "contrast": 1.08,
    "saturation": 1.25,
    "brightness": 0.0,
    "gamma": 1.0,
    "stabilize": "off",
    "stabilize_zoom": 5,
    "wind_filter": true,
    "wind_cutoff_hz": 100
  },
  "montage": {
    "format": "vertical",
    "seconds": 30,
    "min_shot": 1.5,
    "max_shot": 8,
    "gear_max": 3,
    "scene_threshold": 0.3
  },
  "video": {
    "crf": 20,
    "preset": "faster",
    "audio_bitrate": "160k",
    "loudnorm": true
  },
  "event": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "font": "DejaVu Sans",
    "title_bg": "#14213D",
    "accent": "#D9702B",
    "text_color": "#FFFFFF",
    "title_seconds": 4,
    "end_text": "Thank you for watching",
    "end_seconds": 3,
    "lower_third_seconds": 5,
    "fade_seconds": 0.3,
    "loudness_lufs": -14,
    "crf": 20,
    "preset": "faster",
    "audio_bitrate": "192k"
  }
}
